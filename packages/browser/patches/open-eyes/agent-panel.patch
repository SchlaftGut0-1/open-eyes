+// Marks agent tabs in the tab strip with Chromium's own actor alerts.
+class TabMarker : public AgentHub::Observer {
+ public:
+  TabMarker() { AgentHub::Get().AddObserver(this); }
+
+  void OnAgentTabChanged(const std::string& target_id) override {
+    scoped_refptr<content::DevToolsAgentHost> host =
+        content::DevToolsAgentHost::GetForId(target_id);
+    content::WebContents* contents = host ? host->GetWebContents() : nullptr;
+    tabs::TabInterface* tab =
+        contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+    tabs::TabAlertController* alerts =
+        tab ? tabs::TabAlertController::From(tab) : nullptr;
+    if (!alerts) {
+      return;
+    }
+    alerts->OnActorTabIndicatorStateChanged(
+        AgentHub::Get().OwnerOf(target_id) == AgentHub::Owner::kUser
+            ? actor::ui::TabIndicatorStatus::kStatic
+            : actor::ui::TabIndicatorStatus::kDynamic);
+  }
+};
+
+std::unique_ptr<views::View> CreateAgentPanel(BrowserWindowInterface* browser,
+                                              SidePanelEntryScope& scope) {
+  auto scroll = std::make_unique<views::ScrollView>();
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->ClipHeightTo(0, std::numeric_limits<int>::max());
+  scroll->SetContents(std::make_unique<AgentPanelView>(browser));
+  return scroll;
+}
+
+}  // namespace
+
+void RegisterOpenEyesAgentSidePanel(BrowserWindowInterface* browser,
+                                    SidePanelRegistry* registry) {
+  static base::NoDestructor<TabMarker> tab_marker;
+  registry->Register(std::make_unique<SidePanelEntry>(
+      SidePanelEntry::Key(SidePanelEntry::Id::kOpenEyesAgent),
+      base::BindRepeating(&CreateAgentPanel, browser),
+      /*default_content_width_callback=*/base::NullCallback()));
+}
