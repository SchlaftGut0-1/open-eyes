+std::string ActiveTargetId(BrowserWindowInterface* browser) {
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || !content::DevToolsAgentHost::HasFor(contents)) {
+    return std::string();
+  }
+  return content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId();
+}
+
+// shortcut: English only, like the rest of the open-eyes UI, until it is
+// translated.
+class AgentPanelView : public views::View, public AgentHub::Observer {
+ public:
+  explicit AgentPanelView(BrowserWindowInterface* browser) : browser_(browser) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStart);
+    status_ = AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_DIALOG_BODY_TEXT,
+        views::style::STYLE_EMPHASIZED));
+    message_ = AddChildView(std::make_unique<views::Label>());
+    button_ = AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&AgentPanelView::Toggle, base::Unretained(this))));
+    button_->SetStyle(ui::ButtonStyle::kProminent);
+    steps_ = AddChildView(std::make_unique<views::View>());
+    steps_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+    for (views::Label* label : {status_.get(), message_.get()}) {
+      label->SetMultiLine(true);
+      label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    }
+    hub_observation_.Observe(&AgentHub::Get());
+    active_tab_subscription_ =
+        browser->RegisterActiveTabDidChange(base::BindRepeating(
+            &AgentPanelView::OnActiveTabChanged, base::Unretained(this)));
+    Update();
+  }
+
+  void OnAgentTabChanged(const std::string& target_id) override {
+    if (target_id == target_id_) {
+      Update();
+    }
+  }
+
+ private:
+  void OnActiveTabChanged(BrowserWindowInterface* browser) { Update(); }
+
+  void Toggle() {
+    const AgentHub::Tab* tab = AgentHub::Get().Find(target_id_);
+    if (!tab) {
+      return;
+    }
+    if (tab->owner == AgentHub::Owner::kUser) {
+      AgentHub::Get().HandBack(target_id_);
+    } else {
+      AgentHub::Get().TakeControl(target_id_);
+    }
+  }
+
+  void Update() {
+    target_id_ = ActiveTargetId(browser_);
+    const AgentHub::Tab* tab = AgentHub::Get().Find(target_id_);
+    bool user = tab && tab->owner == AgentHub::Owner::kUser;
+    if (!tab) {
+      status_->SetText(u"This tab is not the agent's.");
+    } else if (user) {
+      status_->SetText(u"You are in control. The agent is paused.");
+    } else {
+      status_->SetText(u"The agent is in control.");
+    }
+    message_->SetVisible(user && !tab->handoff_message.empty());
+    if (message_->GetVisible()) {
+      message_->SetText(base::StrCat(
+          {u"The agent asks: ", base::UTF8ToUTF16(tab->handoff_message)}));
+    }
+    button_->SetVisible(tab);
+    button_->SetText(user ? u"Hand back to the agent" : u"Take control");
+    steps_->RemoveAllChildViews();
+    if (tab) {
+      for (auto it = tab->steps.rbegin(); it != tab->steps.rend(); ++it) {
+        auto* step = steps_->AddChildView(std::make_unique<views::Label>(
+            base::StrCat({base::TimeFormatTimeOfDay(it->at), u"  ",
+                          base::UTF8ToUTF16(it->label)}),
+            views::style::CONTEXT_LABEL,
+            it == tab->steps.rbegin() ? views::style::STYLE_PRIMARY
+                                      : views::style::STYLE_SECONDARY));
+        step->SetMultiLine(true);
+        step->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      }
+    }
+    PreferredSizeChanged();
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::string target_id_;
+  raw_ptr<views::Label> status_;
+  raw_ptr<views::Label> message_;
+  raw_ptr<views::MdTextButton> button_;
+  raw_ptr<views::View> steps_;
+  base::ScopedObservation<AgentHub, AgentHub::Observer> hub_observation_{this};
+  base::CallbackListSubscription active_tab_subscription_;
+};
