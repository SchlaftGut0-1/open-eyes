+  if (method == "OpenEyes.handoff") {
+    const std::string* message =
+        command.FindStringByDottedPath("params.message");
+    return hub.Handoff(*target_id, message ? *message : "");
+  }
+  if (method == "OpenEyes.owner") {
+    return hub.OwnerOf(*target_id);
+  }
+  return base::unexpected(method + " is not available in open-eyes Browser");
+}
