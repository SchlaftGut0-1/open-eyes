+++ b/chrome/browser/devtools/open_eyes_agent_hub.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The open-eyes Authors
+// Use of this source code is governed by the MIT license.
+
+#include "chrome/browser/devtools/open_eyes_agent_hub.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+
+namespace open_eyes {
+namespace {
+
+constexpr size_t kMaxSteps = 200;
+
+}  // namespace
+
+// static
+AgentHub& AgentHub::Get() {
+  static base::NoDestructor<AgentHub> hub;
+  return *hub;
+}
+
+AgentHub::AgentHub() = default;
+AgentHub::~AgentHub() = default;
+
+AgentHub::Owner AgentHub::AddStep(const std::string& target_id,
+                                  std::string label) {
+  Tab& tab = tabs_[target_id];
+  if (tab.owner == Owner::kUser) {
+    return tab.owner;
+  }
+  if (tab.steps.size() == kMaxSteps) {
+    tab.steps.pop_front();
+  }
+  tab.steps.push_back({base::Time::Now(), std::move(label)});
+  Notify(target_id);
+  return tab.owner;
+}
+
+AgentHub::Owner AgentHub::Handoff(const std::string& target_id,
+                                  std::string message) {
+  Tab& tab = tabs_[target_id];
+  tab.owner = Owner::kUser;
+  tab.handoff_message = std::move(message);
+  Notify(target_id);
+  return tab.owner;
+}
+
+AgentHub::Owner AgentHub::OwnerOf(const std::string& target_id) const {
+  auto it = tabs_.find(target_id);
+  return it == tabs_.end() ? Owner::kAgent : it->second.owner;
+}
+
+void AgentHub::TakeControl(const std::string& target_id) {
+  auto it = tabs_.find(target_id);
+  if (it == tabs_.end() || it->second.owner == Owner::kUser) {
+    return;
+  }
+  it->second.owner = Owner::kUser;
+  Notify(target_id);
+}
+
+void AgentHub::HandBack(const std::string& target_id) {
+  auto it = tabs_.find(target_id);
+  if (it == tabs_.end() || it->second.owner == Owner::kAgent) {
+    return;
+  }
+  it->second.owner = Owner::kAgent;
+  it->second.handoff_message.clear();
+  Notify(target_id);
+}
+
+const AgentHub::Tab* AgentHub::Find(const std::string& target_id) const {
+  auto it = tabs_.find(target_id);
+  return it == tabs_.end() ? nullptr : &it->second;
+}
+
+void AgentHub::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AgentHub::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void AgentHub::Notify(const std::string& target_id) {
+  for (Observer& observer : observers_) {
+    observer.OnAgentTabChanged(target_id);
+  }
+}
+
+}  // namespace open_eyes
