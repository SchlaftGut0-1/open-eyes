+
+#ifndef CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_HUB_H_
+#define CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_HUB_H_
+
+#include <map>
+#include <string>
+
+#include "base/containers/circular_deque.h"
+#include "base/time/time.h"
+
+namespace open_eyes {
+
+// Who drives each agent tab, by DevTools target id, and what the agent is
+// doing there. The agent socket can only add steps and give control to the
+// user; only the browser's own UI gives it back. UI thread only.
+class AgentHub {
+ public:
+  enum class Owner { kAgent, kUser };
+
+  struct Step {
+    base::Time at;
+    std::string label;
+  };
+
+  struct Tab {
+    Owner owner = Owner::kAgent;
+    std::string handoff_message;
+    base::circular_deque<Step> steps;
+  };
+
+  static AgentHub& Get();
+
+  AgentHub();
+  AgentHub(const AgentHub&) = delete;
+  AgentHub& operator=(const AgentHub&) = delete;
+  ~AgentHub();
+
+  // Records the step the agent is about to take, unless the user is in
+  // control.
+  Owner AddStep(const std::string& target_id, std::string label);
+  Owner Handoff(const std::string& target_id, std::string message);
+  Owner OwnerOf(const std::string& target_id) const;
+
+ private:
+  std::map<std::string, Tab> tabs_;
+};
+
+}  // namespace open_eyes
+
+#endif  // CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_HUB_H_
