+#ifndef CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_SOCKET_H_
+#define CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_SOCKET_H_
+
+namespace open_eyes {
+
+// Lets the open-eyes CLI drive this browser with the DevTools protocol, one
+// JSON message per line, over a socket only the user can open:
+// $XDG_RUNTIME_DIR/open-eyes-browser-<first 12 hex of sha256(user data dir)>.sock.
+// Each connection sees and controls only the tabs the agent opened, and only
+// those tabs report automation; no remote debugging switch is set.
+void StartAgentSocket();
+
+}  // namespace open_eyes
+
+#endif  // CHROME_BROWSER_DEVTOOLS_OPEN_EYES_AGENT_SOCKET_H_
