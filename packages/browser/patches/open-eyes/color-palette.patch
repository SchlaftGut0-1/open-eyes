+#ifndef CHROME_BROWSER_UI_COLOR_OPEN_EYES_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_OPEN_EYES_COLOR_MIXER_H_
+
+#include "ui/color/color_provider_key.h"
+
+namespace ui {
+class ColorProvider;
+}
+
+// open-eyes Browser's own palette for the frame, toolbar, tabs and omnibox,
+// used while the browser color is open-eyes purple and no theme is installed.
+void AddOpenEyesColorMixer(ui::ColorProvider* provider,
+                           const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_OPEN_EYES_COLOR_MIXER_H_
